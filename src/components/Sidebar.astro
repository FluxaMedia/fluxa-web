---
import { docsNav, url } from '../lib/nav';
const groups = await docsNav();
const { slug } = Astro.props;
---
<aside class="sidebar" id="sidebar">
  <a class="sidebar-logo" href={url('/docs')}><img src={url('/logo.png')} alt="Fluxa" /><span>Fluxa Docs<small>Guides and reference</small></span></a>
  <div class="search-wrap">
    <i data-lucide="search" class="search-icon"></i>
    <input type="search" id="search-input" placeholder="Search docs..." aria-label="Search documentation" autocomplete="off" />
    <span class="search-kbd">/</span>
  </div>
  <div id="search-results" class="search-results"></div>
  <nav>
    {groups.map(group => {
      const open = group.items.some(item => item.id === slug);
      return (
        <>
          <button type="button" class="nav-group nav-group-toggle" aria-expanded={String(open)}>
            {group.section}
            <i data-lucide="chevron-down" class="nav-group-chevron"></i>
          </button>
          <div class:list={['nav-group-links', open && 'open']}>
            {group.items.map(item => (
              <a href={url(`/docs/${item.id}`)} class={item.id === slug ? 'active' : ''} aria-current={item.id === slug ? 'page' : undefined}>
                <i data-lucide={item.data.icon} class="nav-icon"></i>{item.data.title}
              </a>
            ))}
          </div>
        </>
      );
    })}
  </nav>
</aside>
