---
import { docsNav, url, docUrl } from '../lib/nav';
import { t, DEFAULT_LOCALE } from '../i18n/ui';

const { slug, locale = DEFAULT_LOCALE } = Astro.props;
const groups = await docsNav(locale);
---
<aside class="sidebar" id="sidebar">
  <a class="sidebar-logo" href={url(locale === DEFAULT_LOCALE ? '/docs' : `/${locale}/docs`)}><img src={url('/logo.png')} alt="Fluxa" /><span>{t(locale, 'docs.title')}<small>{t(locale, 'docs.tagline')}</small></span></a>
  <div class="search-wrap">
    <i data-lucide="search" class="search-icon"></i>
    <input type="search" id="search-input" placeholder={t(locale, 'docs.search')} aria-label={t(locale, 'docs.searchLabel')} autocomplete="off" />
    <span class="search-kbd">/</span>
  </div>
  <div id="search-results" class="search-results" data-empty={t(locale, 'docs.noMatches')} data-empty-hint={t(locale, 'docs.noMatchesHint')}></div>
  <nav>
    {groups.map(group => {
      const open = group.items.some(item => item.slug === slug);
      return (
        <>
          <button type="button" class="nav-group nav-group-toggle" aria-expanded={String(open)}>
            {t(locale, `section.${group.section}` as const)}
            <i data-lucide="chevron-down" class="nav-group-chevron"></i>
          </button>
          <div class:list={['nav-group-links', open && 'open']}>
            {group.items.map(item => (
              <a
                href={docUrl(locale, item.slug)}
                class={item.slug === slug ? 'active' : ''}
                aria-current={item.slug === slug ? 'page' : undefined}
              >
                <i data-lucide={item.entry.data.icon} class="nav-icon"></i>{item.entry.data.title}
                {!item.translated && <span class="nav-untranslated" title="Not translated yet">EN</span>}
              </a>
            ))}
          </div>
        </>
      );
    })}
  </nav>
</aside>
