---
import LanguagePicker from './LanguagePicker.astro';
import { url, localePath } from '../lib/nav';
import { t, DEFAULT_LOCALE } from '../i18n/ui';

const { current = 'docs', locale = DEFAULT_LOCALE, path = '/docs' } = Astro.props;
const home = url(localePath(locale, '/'));
---
<nav class="docs-topbar">
  <div class="docs-topbar-inner">
    <button class="menu-btn" id="menu-btn" aria-label={t(locale, 'nav.toggleDocs')} aria-expanded="false" aria-controls="sidebar"><i data-lucide="panel-left" style="width:18px;height:18px"></i></button>
    <a class="docs-brand" href={home} aria-label="Fluxa home">
      <img src={url('/logo.png')} alt="" />
      <span>Fluxa</span>
      <span class="docs-pill">Docs</span>
    </a>
    <button class="docs-nav-toggle" id="docs-nav-toggle" aria-label={t(locale, 'nav.menu')} aria-expanded="false" aria-controls="docs-top-links">
      <i data-lucide="menu" style="width:20px;height:20px"></i>
    </button>
    <div class="docs-top-links" id="docs-top-links">
      <a class="docs-top-link" href={`${home}#features`}><i data-lucide="layout-grid" style="width:13px;height:13px"></i> {t(locale, 'nav.features')}</a>
      <a class="docs-top-link" href={`${home}#download`}><i data-lucide="download" style="width:13px;height:13px"></i> {t(locale, 'nav.download')}</a>
      <a class:list={['docs-top-link', current === 'docs' && 'active']} href={url(localePath(locale, '/docs'))}><i data-lucide="book-open" style="width:13px;height:13px"></i> {t(locale, 'nav.docs')}</a>
      <a class:list={['docs-top-link', current === 'account' && 'active']} href={url('/account')}><i data-lucide="user" style="width:13px;height:13px"></i> {t(locale, 'nav.account')}</a>
      <a class="docs-top-link" href="https://github.com/FluxaMedia/fluxa-desktop" target="_blank" rel="noreferrer">GitHub</a>
      <LanguagePicker locale={locale} path={path} />
      <a class="docs-top-btn" href={`${home}#download`}><i data-lucide="download" style="width:13px;height:13px"></i> {t(locale, 'nav.download')}</a>
    </div>
  </div>
</nav>
