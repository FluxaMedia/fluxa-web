---
import { url } from '../lib/nav';
import App from '../account/App';
---
<!DOCTYPE html>
<html lang="en" data-base={url('')}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Account · Fluxa</title>
<meta name="description" content="Sign in to manage your Fluxa account: profiles, addons, plugins, library, and settings for Stremio and Nuvio." />
<meta name="robots" content="noindex" />
<link rel="icon" type="image/png" sizes="48x48" href={url('/favicon.png')} />
<link rel="apple-touch-icon" href={url('/logo.png')} />
<link rel="stylesheet" href={url('/type.css')} />
<link rel="stylesheet" href={url('/account.css')} />
</head>
<body>

<nav class="top-nav account-top-nav">
  <div class="nav-container">
    <span id="panel-menu-slot"></span>
    <a class="nav-logo" href={url('/')} aria-label="Fluxa home">
      <img src={url('/logo.png')} alt="" />
      <span>Fluxa</span>
      <span class="nav-context">Account</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Open site menu" aria-expanded="false" aria-controls="nav-links">
      <i data-lucide="menu" style="width:20px;height:20px"></i>
    </button>
    <div class="nav-links" id="nav-links">
      <a class="nav-link" href={url('/#features')}><i data-lucide="layout-grid" style="width:13px;height:13px"></i> Features</a>
      <a class="nav-link" href={url('/#platforms')}><i data-lucide="download" style="width:13px;height:13px"></i> Download</a>
      <a class="nav-link" href={url('/docs')}><i data-lucide="book-open" style="width:13px;height:13px"></i> Docs</a>
      <a class="nav-link active" href={url('/account')} aria-current="page"><i data-lucide="user" style="width:13px;height:13px"></i> Account</a>
      <a class="nav-link" href="https://github.com/FluxaMedia/fluxa-desktop" target="_blank" rel="noreferrer"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg> GitHub</a>
      <a class="nav-btn" href={url('/#platforms')}>
        <i data-lucide="download" style="width:13px;height:13px"></i>
        Download
      </a>
    </div>
  </div>
</nav>

<App client:only="react" base={url('')} />

<script is:inline src={url('/lucide.min.js')}></script>
<script is:inline src={url('/docs-client.js')}></script>
</body>
</html>
