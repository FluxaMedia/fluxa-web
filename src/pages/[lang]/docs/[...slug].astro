---
import { render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { docPaths } from '../../../lib/docpage';
import { localeList, DEFAULT_LOCALE } from '../../../i18n/ui';

export async function getStaticPaths() {
  const locales = localeList.filter(code => code !== DEFAULT_LOCALE);
  const groups = await Promise.all(locales.map(async locale => {
    const paths = await docPaths(locale);
    return paths.map(path => ({
      params: { lang: locale, slug: path.params.slug },
      props: path.props,
    }));
  }));
  return groups.flat();
}

const { entry, ...props } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  badges={entry.data.badges}
  headings={headings}
  {...props}
>
  <Content />
</DocsLayout>
