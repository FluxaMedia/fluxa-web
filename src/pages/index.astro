---
import { url } from '../lib/nav';
import Icon from '../components/Icon.astro';

const REPO_DESKTOP = 'https://github.com/FluxaMedia/fluxa-desktop';
const REPO_ANDROID = 'https://github.com/KhooLy/Fluxa';
const REPO_WEB = 'https://github.com/FluxaMedia/fluxa-web';
const REPO_CORE = 'https://github.com/FluxaMedia/fluxa-core';

const platforms = [
  { icon: 'windows', name: 'Windows' },
  { icon: 'apple', name: 'macOS' },
  { icon: 'linux', name: 'Linux' },
  { icon: 'android', name: 'Android' },
  { icon: 'tv', name: 'webOS' },
];

const connect = [
  { name: 'Trakt', icon: 'trakt.svg' },
  { name: 'Simkl', icon: 'simkl.svg' },
  { name: 'MyAnimeList', icon: 'mal.svg' },
  { name: 'AniList', icon: 'anilist.svg' },
  { name: 'Stremio', icon: 'stremio.svg' },
  { name: 'Nuvio', icon: 'nuvio.png' },
  { name: 'TheIntroDB', icon: 'theintrodb.png' },
  { name: 'IntroDB', icon: 'introdb.svg' },
  { name: 'SkipDB', icon: 'skipdb.png' },
  { name: 'Aniskip' },
  { name: 'MDBList', icon: 'mdblist.svg' },
  { name: 'TMDB', icon: 'tmdb.svg' },
  { name: 'IMDb', icon: 'imdb.svg' },
  { name: 'OMDb' },
];

const shown = [
  {
    id: 'sources',
    name: 'You pick the sources',
    body: 'Fluxa has no catalogue of its own. Paste a Stremio-compatible manifest URL and that addon\u2019s catalogs appear on your home screen straight away. Install as many as you like, turn them on and off per profile, and drag them into the order you want them searched.',
    points: ['Any Stremio-compatible addon', 'Reorder to set search priority', 'Enable or disable without uninstalling'],
    shot: 'addons.webp',
    w: 1168,
    h: 480,
    alt: 'Fluxa add-on settings with a manifest URL field and two installed addons',
  },
  {
    id: 'profiles',
    name: 'A profile for everyone',
    body: 'Up to six profiles on one install, each with its own addons, library, collections, and linked accounts. Nobody\u2019s watch history bleeds into anyone else\u2019s, and any profile can be locked behind a PIN.',
    points: ['Separate library and addons per profile', 'Optional PIN lock', 'Syncs across your devices'],
    shot: 'profiles.webp',
    w: 1200,
    h: 420,
    alt: 'Fluxa profile picker asking who is watching, with four profiles',
  },
];

const features = [
  { name: 'Collections you arrange', body: 'Save titles, group them into custom folders built from addon catalogs, and pin the ones you open most to the top of the home screen.' },
  { name: 'The same app everywhere', body: 'Windows, macOS, Linux, Android, and LG webOS run the same Rust core, so addon behaviour and playback rules match on every device.' },
  { name: 'Torrents without a client', body: 'Magnet links and torrent results stream straight from the results list. No separate download manager, no waiting for a full file.' },
];

const builds = [
  { icon: 'windows', name: 'Windows', req: 'Windows 10 or later. EXE installer, no admin rights needed.', action: 'Download .exe', href: REPO_DESKTOP + '/releases/latest' },
  { icon: 'apple', name: 'macOS', req: 'macOS 11 or later. Universal binary for Intel and Apple Silicon.', action: 'Download .dmg', href: REPO_DESKTOP + '/releases/latest' },
  { icon: 'linux', name: 'Linux', req: '.deb, .rpm, and .AppImage. mpv is bundled.', action: 'Download', href: REPO_DESKTOP + '/releases/latest' },
  { icon: 'android', name: 'Android', req: 'Phones and tablets. Same addons as the desktop build.', action: 'Download .apk', href: REPO_ANDROID + '/releases/latest' },
  { icon: 'tv', name: 'webOS', req: 'LG Smart TVs via Developer Mode. Also runs in any browser.', action: 'Download', href: REPO_WEB + '/releases/latest' },
];

const repos = [
  { id: 'fluxa-core', lang: 'Rust', href: REPO_CORE, desc: 'Shared library — addon resolution, streaming, library state, search, and playback policy.' },
  { id: 'fluxa-desktop', lang: 'TypeScript, Rust', href: REPO_DESKTOP, desc: 'Desktop app on Tauri and React for Windows, macOS, and Linux.' },
  { id: 'fluxa-android', lang: 'Kotlin', href: REPO_ANDROID, desc: 'Android app for phones and tablets.' },
  { id: 'fluxa-web', lang: 'TypeScript', href: REPO_WEB, desc: 'Browser client, also packaged as a native app for LG webOS.' },
];

const views = [
  { id: 'desktop', label: 'Desktop', file: 'home-desktop.webp', w: 1400, h: 889 },
  { id: 'mobile', label: 'Mobile', file: 'home-mobile.webp', w: 520, h: 1114 },
  { id: 'tv', label: 'TV', file: 'home-tv.webp', w: 1400, h: 788 },
];

const title = 'Fluxa — open-source media player';
const description = 'Free, open-source media player for Windows, macOS, Linux, Android, and LG webOS. Connect the addons you want and play them with mpv.';
---
<!DOCTYPE html>
<html lang="en" data-base={url('')}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={url('/logo.png')} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={url('/logo.png')} />
<link rel="icon" type="image/png" sizes="48x48" href={url('/favicon.png')} />
<link rel="apple-touch-icon" href={url('/logo.png')} />
<link rel="preload" as="font" type="font/woff2" href={url('/fonts/archivo-latin.woff2')} crossorigin />
<link rel="stylesheet" href={url('/landing.css')} />
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a class="nav-brand" href={url('/')}>
      <img src={url('/logo.png')} alt="" />
      Fluxa
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
      <Icon name="menu" size={18} />
    </button>
    <div class="nav-menu" id="nav-menu">
      <a href="#features">Features</a>
      <a href="#download">Download</a>
      <a href={url('/docs')}>Docs</a>
      <a href={url('/account')}>Account</a>
      <a href={REPO_DESKTOP} target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn-primary" href="#download">Download</a>
    </div>
  </div>
</nav>

<header class="hero wrap">
  <div class="hero-copy">
    <h1>A media player that plays what you bring it.</h1>
    <p>
      Fluxa is free and open source. It ships no content of its own — you connect the addons, and
      it plays them with mpv, tracks what you watch, and keeps your library in sync.
    </p>
    <div class="hero-buttons">
      <a class="btn btn-primary" href="#download"><Icon name="download" size={15} /> Download</a>
      <a class="btn btn-ghost" href={url('/docs')}><Icon name="book-open" size={15} /> Read the docs</a>
    </div>
    <div class="hero-runs">
      {platforms.map(p => <span><Icon name={p.icon} size={15} /> {p.name}</span>)}
    </div>
  </div>

  <div class="hero-preview">
    <div class="switch" role="tablist" aria-label="Choose a layout">
      {views.map((v, i) => (
        <button role="tab" data-view={v.id} aria-selected={i === 0} class={i === 0 ? 'active' : undefined}>{v.label}</button>
      ))}
    </div>
    <div class="stage">
      {views.map((v, i) => (
        <img
          data-view={v.id}
          class={i === 0 ? undefined : 'hidden'}
          src={url('/shots/' + v.file)}
          width={v.w}
          height={v.h}
          alt={`Fluxa home screen on ${v.label.toLowerCase()}`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </div>
</header>

<section class="section wrap" id="features">
  <h2>What it does</h2>
  <p class="lead">Nothing is gated, nothing phones home, and there is no paid version.</p>

  <div class="section-body showcase">
    {shown.map(f => (
      <div class="show">
        <div class="show-copy">
          <h3>{f.name}</h3>
          <p>{f.body}</p>
          <ul>{f.points.map(pt => <li>{pt}</li>)}</ul>
        </div>
        <img src={url('/shots/' + f.shot)} width={f.w} height={f.h} alt={f.alt} loading="lazy" />
      </div>
    ))}

    <div class="show">
      <div class="show-copy">
        <h3>Skip the intro</h3>
        <p>
          Intro and recap segments are detected as an episode starts, so the prompt is already
          there when the theme music kicks in. Press it once and playback jumps to the first scene.
          Ignore it and it fades out on its own.
        </p>
        <ul>
          <li>Detected before the segment begins</li>
          <li>One press, or one key on the remote</li>
          <li>Never blocks the picture</li>
        </ul>
      </div>
      <div class="demo">
        <video id="demo-video" muted loop playsinline preload="metadata"
          src="https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/720/Big_Buck_Bunny_720_10s_1MB.mp4"></video>
        <button class="demo-skip" id="demo-skip" type="button" hidden>Skip Intro</button>
        <div class="demo-bar"><span id="demo-fill"></span></div>
        <p class="demo-credit">Demo clip: <em>Big Buck Bunny</em>, Blender Foundation, CC BY 3.0</p>
      </div>
    </div>
  </div>

  <div class="features">
    {features.map(f => (
      <div class="feature">
        <h3>{f.name}</h3>
        <p>{f.body}</p>
      </div>
    ))}
  </div>
</section>

<section class="connect" aria-label="Services Fluxa works with">
  <p class="connect-label">Works with</p>
  <div class="marquee">
    <div class="marquee-track">
      {[0, 1].map(() => connect.map(item => (
        <span class="mark">
          {item.icon && <img src={url('/logos/' + item.icon)} alt="" width="24" height="24" />}
          {item.name}
        </span>
      )))}
    </div>
  </div>
</section>

<section class="section wrap" id="download">
  <h2>Download</h2>
  <p class="lead">Every release is published on GitHub. No account needed.</p>
  <div class="section-body rows">
    {builds.map(b => (
      <a class="row" href={b.href} target="_blank" rel="noopener">
        <span class="row-icon"><Icon name={b.icon} size={18} /></span>
        <span class="row-main">
          <span class="row-name" style="display:block">{b.name}</span>
          <span class="row-desc" style="display:block">{b.req}</span>
        </span>
        <span class="row-action">{b.action} <Icon name="arrow-right" size={14} /></span>
      </a>
    ))}
  </div>
</section>

<section class="section wrap" id="source">
  <h2>Source</h2>
  <p class="lead">Four repositories: one shared Rust core and three platform apps built on it.</p>
  <div class="section-body rows">
    {repos.map(r => (
      <a class="row" id={'repo-' + r.id} href={r.href} target="_blank" rel="noopener">
        <span class="row-main">
          <span class="row-name" style="display:block">{r.id}</span>
          <span class="row-desc" style="display:block">{r.desc} · {r.lang}</span>
        </span>
        <span class="row-meta">
          <span><Icon name="star" size={13} /><span class="repo-stars">–</span></span>
          <span><Icon name="git-fork" size={13} /><span class="repo-forks">–</span></span>
        </span>
      </a>
    ))}
  </div>
</section>

<section class="section wrap">
  <h2>Latest releases</h2>
  <div class="section-body" id="release-list">
    {[0, 1, 2].map(() => (
      <div class="release">
        <div class="release-head"><span class="skel skel-tag" aria-hidden="true"></span></div>
        <div class="release-notes" aria-hidden="true">
          <span class="skel skel-line"></span>
          <span class="skel skel-line" style="width:80%"></span>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section wrap">
  <h2>Contributors</h2>
  <p class="lead">Everyone who has committed across the four repositories.</p>
  <div class="section-body people" id="people-grid">
    {[0, 1, 2, 3, 4, 5, 6, 7].map(() => <span class="skel skel-person" aria-hidden="true"></span>)}
  </div>
</section>

<footer class="footer wrap">
  <div class="footer-inner">
    <a class="nav-brand" href={url('/')}><img src={url('/logo.png')} alt="" /> Fluxa</a>
    <div class="footer-links">
      <a href={url('/docs')}>Docs</a>
      <a href={url('/docs/getting-started')}>Getting started</a>
      <a href={url('/docs/faq')}>FAQ</a>
      <a href={url('/account')}>Account</a>
      <a href={REPO_CORE} target="_blank" rel="noopener">Core</a>
      <a href={REPO_DESKTOP} target="_blank" rel="noopener">Desktop</a>
      <a href={REPO_ANDROID} target="_blank" rel="noopener">Android</a>
      <a href={REPO_WEB} target="_blank" rel="noopener">Web</a>
      <a href={REPO_DESKTOP + '/issues'} target="_blank" rel="noopener">Issues</a>
    </div>
  </div>
  <p class="footer-note">
    Fluxa is free and open-source software. It provides no catalogues, streams, or content, and is
    not affiliated with any provider.
  </p>
</footer>

<script is:inline src={url('/landing.js')}></script>
</body>
</html>
